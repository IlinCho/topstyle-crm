# Defense in depth for the product photo upload folder: even though
# save_uploaded_product_images() in includes/helpers.php only accepts files
# that pass getimagesize() (a real image header check, not just extension),
# this blocks anything in here from ever being executed as a script if a
# validation gap is ever found.
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|cgi|sh)$">
  Require all denied
  Deny from all
</FilesMatch>
Options -ExecCGI
