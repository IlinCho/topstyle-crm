// TopStyle CRM - database schema
// Local dev uses SQLite (zero setup). For Vercel, switch provider to
// "postgresql" and point DATABASE_URL at Vercel Postgres / Neon - see README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
url      = env("NEON_DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  position  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String          @id @default(cuid())
  sku          String          @unique
  name         String
  slug         String          @unique
  description  String          @default("")
  material     String          @default("")
  color        String          @default("")
  priceEur     Float
  priceBgn     Float
  active       Boolean         @default(true)
  featured     Boolean         @default(false)
  // Comma-separated subset of: bestseller, new, limited, most_popular.
  // Set manually from the admin panel - never inferred automatically, so
  // the client always controls exactly which real claim is shown.
  badges       String          @default("")
  sourceUrl    String          @default("")
  categoryId   String
  category     Category        @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  variants     ProductVariant[]
  orderItems   OrderItem[]
  reviews      Review[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int // 1-5
  comment    String   @default("")
  createdAt  DateTime @default(now())
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String   @default("")
  stock     Int      @default(0)

  @@unique([productId, size, color])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  phone        String   @default("")
  address      String   @default("")
  city         String   @default("")
  // Empty passwordHash = record created from a guest order, no login account yet.
  // Non-empty = the customer has registered and can log in.
  passwordHash String   @default("")
  orders       Order[]
  createdAt    DateTime @default(now())
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  guestName   String      @default("")
  guestEmail  String      @default("")
  guestPhone  String      @default("")
  address     String      @default("")
  city        String      @default("")
  deliveryMethod String   @default("") // econt_office | speedy_address | ...
  officeName  String      @default("") // e.g. selected Econt office, if applicable
  status      String      @default("pending") // pending, confirmed, shipped, delivered, cancelled
  totalBgn    Float
  totalEur    Float
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  productName  String
  size         String
  color        String
  qty          Int
  priceBgn     Float
  priceEur     Float
}
