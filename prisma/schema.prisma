// TopStyle CRM - database schema
// Local dev uses SQLite (zero setup). For Vercel, switch provider to
// "postgresql" and point DATABASE_URL at Vercel Postgres / Neon - see README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
url      = env("NEON_DATABASE_URL")
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  position  Int        @default(0)
  // Homepage tile image (the 3 top-level "Топ категории" shown under the
  // hero). Empty string = falls back to the category's first product image
  // at render time, so a tile never shows visibly broken.
  imageUrl  String     @default("")
  products  Product[]
  // Self-relation for one level of subcategories (e.g. "Мъжки тениски" ->
  // "Тениски с яка"). parentId null = top-level category.
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id           String          @id @default(cuid())
  sku          String          @unique
  name         String
  slug         String          @unique
  description  String          @default("")
  material     String          @default("")
  color        String          @default("")
  priceEur     Float
  priceBgn     Float
  active       Boolean         @default(true)
  featured     Boolean         @default(false)
  // Manual pin position (1-8) controlling display order within the product's
  // category page - lets the admin push best-sellers / picks to the front
  // instead of always sorting by newest. Null = no pin, falls back to newest-first.
  categoryRank Int?
  // Comma-separated subset of: bestseller, new, limited, most_popular.
  // Set manually from the admin panel - never inferred automatically, so
  // the client always controls exactly which real claim is shown.
  badges       String          @default("")
  sourceUrl    String          @default("")
  // Optional per-product size chart image, shown to customers when they
  // click "Как да избера размер?" on the product page. Empty = fall back
  // to the generic sizing advice text.
  sizeChartUrl String          @default("")
  // Free-text sizing guidance the admin can write per product (e.g. "този
  // модел пасва по-плътно, вземете размер по-голям") - shown above the size
  // chart image (if any) inside the same toggle. Different per product;
  // empty = show nothing extra beyond the image/fallback text.
  sizeChartNote String         @default("")
  // Structured measurement table, entered by the admin as plain CSV text
  // (first line = column headers, e.g. "Размер,Талия,Дължина" then one row
  // per size) - parsed and rendered as a real HTML <table> on the product
  // page, instead of admins pasting unstructured measurement text into
  // sizeChartNote where it renders as an unreadable wall of numbers.
  sizeChartTable String        @default("")
  categoryId   String
  category     Category        @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  variants     ProductVariant[]
  orderItems   OrderItem[]
  reviews      Review[]
  stockAlerts  StockAlert[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// "Уведоми ме при наличност" - captured when a customer picks a sold-out
// size/color combo. Turns a lost sale into a real demand signal the admin
// can see (Admin -> Известия за наличност), instead of the visitor just
// bouncing off a dead "Изчерпан" button.
model StockAlert {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String   @default("")
  email     String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId, size, color])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int // 1-5
  comment    String   @default("")
  createdAt  DateTime @default(now())
}

// Login brute-force protection for both admin and customer login. Each failed
// attempt inserts a row keyed by a scope like "admin:email:x@y.com" or
// "admin:ip:1.2.3.4" - checking both email and IP means an attacker can't get
// around the limit just by rotating one or the other. Rows age out on their
// own (see src/lib/rate-limit.ts), so this table stays small.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String   @default("")
  stock     Int      @default(0)

  @@unique([productId, size, color])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  phone        String   @default("")
  address      String   @default("")
  city         String   @default("")
  // Empty passwordHash = record created from a guest order, no login account yet.
  // Non-empty = the customer has registered and can log in.
  passwordHash String   @default("")
  orders       Order[]
  createdAt    DateTime @default(now())
}

// Captures a checkout the customer started (typed name/email/phone) but never
// finished - upserted by a client-generated key as they progress through the
// checkout steps (see CheckoutForm.tsx + /api/abandoned-checkout), and
// deleted the moment a real Order is placed with that same key (see
// /api/checkout). Lets the admin see and follow up on likely-lost sales
// instead of them just disappearing when the customer closes the tab.
model AbandonedCheckout {
  id        String   @id @default(cuid())
  clientKey String   @unique
  name      String   @default("")
  email     String   @default("")
  phone     String   @default("")
  city      String   @default("")
  // Highest checkout step reached (1 = personal info, 2 = delivery, 3 =
  // payment/confirmation) - a rough signal of how "hot" the lead is.
  step      Int      @default(1)
  itemsJson String   @default("[]")
  totalBgn  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  guestName   String      @default("")
  guestEmail  String      @default("")
  guestPhone  String      @default("")
  address     String      @default("")
  city        String      @default("")
  deliveryMethod String   @default("") // econt_office | speedy_address | ...
  officeName  String      @default("") // e.g. selected Econt office, if applicable
  status      String      @default("pending") // pending, confirmed, shipped, delivered, cancelled
  seenByAdmin Boolean     @default(false) // powers the admin sidebar's order notification bell
  // Set once, at order-creation time, by matching the order's contact email/
  // phone against the LegacyCustomer table (imported from the old PrestaShop
  // store) - lets the admin tell at a glance whether an order is from a
  // returning pre-migration customer ("Стар клиент") or a genuinely new one
  // ("Нов клиент"). Never recomputed automatically afterwards; see the
  // "Преизчисли" admin action for backfilling orders placed before an import.
  isLegacy    Boolean     @default(false)
  totalBgn    Float
  totalEur    Float
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// One-time-imported reference list of customers who already bought from the
// old topstyle.bg (PrestaShop) store, exported by the admin from the old
// store's admin panel and pasted in as CSV on Admin -> Стари клиенти. Used
// only as a lookup at order-creation time (see Order.isLegacy above) - not
// linked to Customer/Order by foreign key, since it's matched by normalized
// email/phone text, not by id (the old store's ids mean nothing here).
model LegacyCustomer {
  id        String   @id @default(cuid())
  // Normalized lower-cased/trimmed email, or "" if only a phone was known.
  email     String   @default("")
  // Normalized to the last 9 digits (matches Bulgarian mobile numbers
  // regardless of +359/0/00359 prefix variations), or "" if only an email
  // was known.
  phone     String   @default("")
  name      String   @default("")
  createdAt DateTime @default(now())

  @@index([email])
  @@index([phone])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  productName  String
  size         String
  color        String
  qty          Int
  priceBgn     Float
  priceEur     Float
}
