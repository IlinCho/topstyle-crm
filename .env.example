# Copy this file to .env and fill in real values. .env itself is gitignored -
# never commit real secrets, only this placeholder template.

# ---- Database (Neon Postgres) ----
NEON_DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# ---- Admin session signing ----
# Long random string (e.g. `openssl rand -hex 32`) used to sign admin/customer
# login session cookies. If this is missing, the app falls back to an
# insecure default that's visible in the source code - always set a real one.
SESSION_SECRET="change-this-to-a-long-random-string"

# ---- First admin account (used only by prisma/seed.ts) ----
ADMIN_EMAIL="admin@topstyle.bg"
ADMIN_PASSWORD="choose-a-strong-password"

# ---- Vercel Blob (product photo uploads) ----
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# ---- Transactional email (order confirmation + admin new-order alert) ----
# Sent via Resend's HTTP API (resend.com) - free account, no npm package
# needed. Leave RESEND_API_KEY empty to disable email sending entirely
# (orders still save normally either way).
RESEND_API_KEY=""
EMAIL_FROM="TopStyle.bg <onboarding@resend.dev>"
# Where "new order" alert emails go - leave empty to disable that one email.
ADMIN_NOTIFY_EMAIL=""

# ---- Marketing/tracking (only loaded after the cookie banner is accepted -
# see CookieConsent.tsx + Analytics.tsx). Leave any of these empty to skip
# that specific tracker entirely. ----
NEXT_PUBLIC_GA_ID=""            # Google Analytics 4, e.g. "G-XXXXXXXXXX"
NEXT_PUBLIC_FB_PIXEL_ID=""      # Meta/Facebook Pixel numeric ID
NEXT_PUBLIC_GTM_ID=""           # Google Tag Manager, e.g. "GTM-XXXXXXX"
NEXT_PUBLIC_CLARITY_ID=""       # Microsoft Clarity project ID

# ---- Public display text (safe to expose client-side - no secrets here) ----
NEXT_PUBLIC_STORE_NAME="TopStyle.bg"
NEXT_PUBLIC_STORE_PHONE="0877 968 927"
NEXT_PUBLIC_STORE_EMAIL="office@topstyle.bg"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/topstyle.bg"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/topstyle.bg"
